+        // A state set from a material property ("ColorMask [_ColorMask]", "Ref [_Stencil]") is stored
+        // as the property's name next to the property's default value. Written as that value, TMP's
+        // "ColorMask [_ColorMask]" (default 0 in the data) drew nothing; the reference is written instead.
+        // A state written as a value has the name "<noninit>".
+        private static string PropertyRef(AssetTypeValueField value)
+        {
+            var name = value["name"];
+            if (name.IsDummy || string.IsNullOrEmpty(name.AsString) || name.AsString == "<noninit>")
+            {
+                return null;
+            }
+            return $"[{name.AsString}]";
+        }
+
+        private static string StateValue(AssetTypeValueField value, object literal)
+        {
+            return PropertyRef(value) ?? Convert.ToString(literal, CultureInfo.InvariantCulture);
+        }
+
